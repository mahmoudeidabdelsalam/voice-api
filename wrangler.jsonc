{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "nexvora-voice-api",
  "main": "src/index.ts",

  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  "workers_dev": true,

  "observability": {
    "enabled": true
  },

  "vars": {
    "ALLOWED_ORIGINS": "https://nexvoraagency.com,https://www.nexvoraagency.com",
    "AGENT_NAME": "nexvora-assistant"
  },

  "secrets": {
    "required": [
      "LIVEKIT_URL",
      "LIVEKIT_API_KEY",
      "LIVEKIT_API_SECRET"
    ]
  },

  "ratelimits": [
    {
      "name": "VOICE_API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}